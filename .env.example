# 首次部署务必修改
POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_API_TOKEN=replace-with-a-long-random-token

# 可留空，之后从 Web 页面添加
HUYA_ROOM_ID=1995
PORT=3000

# 可选运行参数
LIVE_POLL_INTERVAL_SECONDS=60
OFFLINE_CONFIRMATIONS=2
HOT_RETENTION_MONTHS=12
RAW_PAYLOAD_RETENTION_DAYS=30
STORAGE_SAMPLE_MINUTES=60
